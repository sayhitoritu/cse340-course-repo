<%- include('partials/header', { title: title }) %>

    <section class="page-heading">
        <p class="eyebrow">Add a changemaker</p>
        <h1>
            <%= title %>
        </h1>
        <p>Enter the details of the new organization below.</p>
    </section>

    <section class="form-container">
        <form action="/new-organization" method="POST">

            <div class="form-group">
                <label for="name">Organization Name</label>
                <input type="text" id="name" name="name" maxlength="150" required>
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" rows="5" maxlength="500" required></textarea>
            </div>

            <div class="form-group">
                <label for="contactEmail">Contact Email</label>
                <input type="email" id="contactEmail" name="contactEmail" required>
            </div>

            <button type="submit">Create Organization</button>
        </form>

        <p>
            <a href="/organizations">Back to Organizations</a>
        </p>
    </section>

    <%- include('partials/footer') %>