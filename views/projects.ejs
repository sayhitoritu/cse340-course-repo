<%- include('partials/header', { title: title }) %>

    <section class="page-heading">
        <p class="eyebrow">Make a difference</p>
        <h1>Service Projects</h1>
        <p>Explore upcoming opportunities to serve your community.</p>
    </section>

    <section class="content-section">
        <h2>Upcoming Service Projects</h2>

        <div class="card-grid">
            <% if (projects.length> 0) { %>
                <% projects.forEach((project)=> { %>
                    <article class="card">
                        <h3>
                            <a href="/project/<%= project.project_id %>">
                                <%= project.name %>
                            </a>
                        </h3>

                        <p>
                            <%= project.description %>
                        </p>

                        <p>
                            <strong>Organization:</strong>
                            <a href="/organization/<%= project.organization_id %>">
                                <%= project.organization_name %>
                            </a>
                        </p>

                        <p>
                            <strong>Location:</strong>
                            <%= project.location || 'To be announced' %>
                        </p>

                        <p>
                            <strong>Date:</strong>
                            <%= project.project_date ? new Date(project.project_date).toLocaleDateString()
                                : 'To be announced' %>
                        </p>
                    </article>
                    <% }) %>
                        <% } else { %>
                            <p>No upcoming projects are available right now.</p>
                            <% } %>
        </div>
    </section>

    <%- include('partials/footer') %>