<%- include('partials/header', { title: title }) %>

    <section class="hero">
        <p class="eyebrow">Make a difference together</p>
        <h1>Welcome to Service Network</h1>
        <p>Connect with organizations, discover service projects, and find meaningful ways to serve your community.</p>
        <a class="button" href="/projects">Explore Service Projects</a>
        <img class="home-image" src="/images/homepage-service.jpg"
            alt="Volunteers working together to clean a community area">
    </section>

    <section class="content-section">
        <h2>Find Your Way to Serve</h2>
        <div class="card-grid">
            <article class="card">
                <h3>Organizations</h3>
                <p>Discover organizations making a difference in your community.</p>
                <a href="/organizations">Explore organizations</a>
            </article>
            <article class="card">
                <h3>Service Projects</h3>
                <p>Find opportunities to share your time and talents.</p>
                <a href="/projects">View projects</a>
            </article>
            <article class="card">
                <h3>Categories</h3>
                <p>Explore service opportunities by category.</p>
                <a href="/categories">Browse categories</a>
            </article>
        </div>
    </section>

    <%- include('partials/footer') %>