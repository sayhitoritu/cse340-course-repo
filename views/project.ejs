<%- include('partials/header', { title: title }) %>

    <section class="page-heading">
        <p class="eyebrow">Make a difference</p>

        <h1>
            <%= project.name %>
        </h1>

        <p>
            <%= project.description %>
        </p>
    </section>

    <section class="content-section" aria-labelledby="details-heading">
        <h2 id="details-heading">Project Details</h2>

        <article class="card">
            <p>
                <strong>Organization:</strong>
                <a href="/organization/<%= project.organization_id %>">
                    <%= project.organization_name %>
                </a>
            </p>

            <p>
                <strong>Location:</strong>
                <%= project.location || "To be announced" %>
            </p>

            <p>
                <strong>Date:</strong>
                <%= project.project_date ? new Date(project.project_date).toLocaleDateString() : "To be announced" %>
            </p>

            <h3>Categories</h3>

            <div class="category-tags" aria-label="Project categories">
                <% if (categories && categories.length> 0) { %>

                    <% categories.forEach((category)=> { %>
                        <a class="category-label" href="/category/<%= category.category_id %>">
                            <%= category.name %>
                        </a>
                        <% }) %>

                            <% } else { %>
                                <p>No categories assigned.</p>
                                <% } %>
            </div>
        </article>
    </section>

    <%- include('partials/footer') %>