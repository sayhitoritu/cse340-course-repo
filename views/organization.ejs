<%- include('partials/header', { title: title }) %>

    <section class="page-heading">
        <p class="eyebrow">Our community partners</p>
        <h1>
            <%= organization.name %>
        </h1>
        <p>
            <%= organization.description %>
        </p>
        <p>Contact: <%= organization.contact_email %>
        </p>
    </section>

    <section class="content-section">
        <h2>Service Projects</h2>

        <div class="card-grid">
            <% if (projects.length> 0) { %>
                <% projects.forEach((project)=> { %>
                    <article class="card">
                        <h3>
                            <a href="/project/<%= project.project_id %>">
                                <%= project.name %>
                            </a>
                        </h3>
                        <p>
                            <%= project.description %>
                        </p>
                        <p>
                            <%= project.location %>
                        </p>
                    </article>
                    <% }) %>
                        <% } else { %>
                            <p>No projects available for this organization.</p>
                            <% } %>
        </div>
    </section>

    <%- include('partials/footer') %>