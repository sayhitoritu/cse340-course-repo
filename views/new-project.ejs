<%- include('partials/header', { title: title }) %>

    <section class="page-heading">
        <p class="eyebrow">Create an opportunity to serve</p>
        <h1>
            <%= title %>
        </h1>
        <p>Enter the details of the new service project.</p>
    </section>

    <section class="form-container">
        <form action="/projects/new-project" method="POST">

            <div class="form-group">
                <label for="title">Project Title</label>
                <input type="text" id="title" name="title" maxlength="200" required>
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" rows="5" maxlength="1000" required></textarea>
            </div>

            <div class="form-group">
                <label for="location">Location</label>
                <input type="text" id="location" name="location" maxlength="200" required>
            </div>

            <div class="form-group">
                <label for="date">Project Date</label>
                <input type="date" id="date" name="date" required>
            </div>

            <div class="form-group">
                <label for="organizationId">Organization</label>
                <select id="organizationId" name="organizationId" required>
                    <option value="">Select an organization</option>

                    <% organizations.forEach(org=> { %>
                        <option value="<%= org.organization_id %>">
                            <%= org.name %>
                        </option>
                        <% }); %>
                </select>
            </div>

            <button type="submit">Create Project</button>
        </form>

        <p>
            <a href="/projects">Back to Service Projects</a>
        </p>
    </section>

    <%- include('partials/footer') %>