<%- include('partials/header', { title: title }) %>

    <section class="page-heading">
        <p class="eyebrow">Project Management</p>

        <h1>Edit Service Project</h1>

        <p>Update the project details below.</p>
    </section>

    <section class="content-section">
        <article class="card">

            <form action="/projects/edit/<%= project.project_id %>" method="POST">

                <div class="form-group">
                    <label for="title">Project Title</label>

                    <input type="text" id="title" name="title" value="<%= project.name %>" minlength="3" maxlength="200"
                        required>
                </div>

                <div class="form-group">
                    <label for="description">Description</label>

                    <textarea id="description" name="description" maxlength="1000" required
                        rows="5"><%= project.description %></textarea>
                </div>

                <div class="form-group">
                    <label for="location">Location</label>

                    <input type="text" id="location" name="location" value="<%= project.location %>" maxlength="200"
                        required>
                </div>



                <div class="form-group">
                    <label for="date">Project Date</label>

                    <input type="date" id="date" name="date" value="<%= project.formatted_project_date || '' %>"
                        required>
                </div>



                <div class="form-group">
                    <label for="organizationId">Organization</label>

                    <select id="organizationId" name="organizationId" required>
                        <% organizations.forEach((organization)=> { %>
                            <option value="<%= organization.organization_id %>"
                                <%=Number(organization.organization_id)===Number(project.organization_id) ? "selected"
                                : "" %>
                                >
                                <%= organization.name %>
                            </option>
                            <% }) %>
                    </select>
                </div>

                <button type="submit">Update Project</button>

            </form>

            <p>
                <a href="/project/<%= project.project_id %>">
                    Back to Project
                </a>
            </p>

        </article>
    </section>

    <%- include('partials/footer') %>