<%- include('partials/header', { title: title }) %>

    <section class="page-heading">
        <p class="eyebrow">Update our community partner</p>
        <h1>
            <%= title %>
        </h1>
        <p>Update the organization details below.</p>
    </section>

    <section class="form-container">
        <form action="/edit-organization/<%= organization.organization_id %>" method="POST">

            <div class="form-group">
                <label for="name">Organization Name</label>
                <input type="text" id="name" name="name" value="<%= organization.name %>" maxlength="150" required>
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" rows="5" maxlength="500"
                    required><%= organization.description %></textarea>
            </div>

            <div class="form-group">
                <label for="contactEmail">Contact Email</label>
                <input type="email" id="contactEmail" name="contactEmail" value="<%= organization.contact_email %>"
                    maxlength="255" required>
            </div>

            <div class="form-group">
                <label for="image">Logo Filename</label>
                <input type="text" id="image" name="image" value="<%= organization.image || '' %>" maxlength="255"
                    required>
            </div>

            <button type="submit">Update Organization</button>
        </form>

        <p>
            <a href="/organization/<%= organization.organization_id %>">
                Cancel and return to Organization
            </a>
        </p>
    </section>

    <%- include('partials/footer') %>