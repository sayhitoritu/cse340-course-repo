<%- include('partials/header', { title: title }) %>

    <section class="page-heading">
        <p class="eyebrow">Project Management</p>
        <h1>Assign Categories</h1>
        <p>Select the categories that apply to this project.</p>
    </section>

    <section class="content-section">
        <article class="card">
            <h2>
                <%= project.name %>
            </h2>

            <form action="/category/project/<%= projectId %>/assign-categories" method="POST">
                <fieldset>
                    <legend>Select Project Categories</legend>


                    <% categories.forEach((category)=> { %>
                        <div>
                            <label>
                                <input type="checkbox" name="categoryIds" value="<%= category.category_id %>"
                                    <%=assignedCategories.some(assigned=> Number(assigned.category_id) ===
                                Number(category.category_id)) ? "checked" : "" %>
                                >
                                <%= category.name %>
                            </label>
                        </div>
                        <% }) %>

                </fieldset>

                <button type="submit">Save Categories</button>
            </form>

            <p>
                <a href="/project/<%= projectId %>">Back to Project</a>
            </p>
        </article>
    </section>

    <%- include('partials/footer') %>